# ---------------------------------------------------------------------------
# Este repositório versiona apenas o necessário para REPLICAR o experimento:
# código, requirements.txt e README.md. Tudo que é gerado ao rodar os testes
# fica de fora — é reprodutível com `python main.py <teste>`.
# ---------------------------------------------------------------------------

# Cache dos datasets baixados do PMLB
cache/
*.tsv.gz

# Artefatos de escrita (artigo, TCC) — não fazem parte da replicação
*.pdf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Ambientes virtuais
.venv/
venv/
env/

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

#Arquivos diferentes
results_backup/
# TCC (LaTeX): versiona os fontes e as figuras, ignora os auxiliares
!tcc/figuras/*.pdf
tcc/*.aux
tcc/*.bbl
tcc/*.blg
tcc/*.fdb_latexmk
tcc/*.fls
tcc/*.log
tcc/*.lof
tcc/*.lot
tcc/*.out
tcc/*.toc
tcc/*.synctex.gz
